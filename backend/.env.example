GCP_PROJECT_ID=prisk-ai
FIREBASE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-fbsvc@prisk-ai.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=
ENVIRONMENT=development
USE_IN_MEMORY_FIRESTORE=true
USE_MOCK_FIREBASE_AUTH=true

# MeetStream AI Integration (for Task 3 bot dispatch & webhook ingestion)
MEETSTREAM_API_KEY=your_meetstream_api_key_here
MEETSTREAM_WEBHOOK_SECRET=your_meetstream_webhook_signing_secret_here

# GCS Compliance Bucket (Bucket names are globally unique)
GCS_COMPLIANCE_BUCKET_NAME=prisk-compliance-packages-prisk-ai

# Vertex AI Gemini & Vector Embeddings (Task 4)
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_NAME=gemini-3.8-flash
EMBEDDING_MODEL_NAME=text-embedding-004

# Optional email alerting (SendGrid / SMTP for Task 1/6 escalation alerts)
SENDGRID_API_KEY=your_sendgrid_key_if_available
